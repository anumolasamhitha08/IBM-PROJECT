# FinSakhi AI – Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ════════════════════════════════════════════════════════════════
# IBM WATSONX / GRANITE CONFIGURATION (REQUIRED for LLM features)
# ════════════════════════════════════════════════════════════════

# Your IBM Cloud API Key (generate at cloud.ibm.com/iam/apikeys)
IBM_API_KEY=your_ibm_api_key_here

# Your WatsonX Project ID (find in watsonx.ai → Projects → Your Project → Manage)
IBM_PROJECT_ID=your_ibm_project_id_here

# WatsonX endpoint URL (default is us-south; change for your region)
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model to use (recommended: ibm/granite-3-3-8b-instruct)
IBM_GRANITE_MODEL_ID=ibm/granite-3-3-8b-instruct

# ════════════════════════════════════════════════════════════════
# IBM WATSON DISCOVERY (Optional – for web-crawled document retrieval)
# ════════════════════════════════════════════════════════════════

IBM_DISCOVERY_API_KEY=your_discovery_api_key_here
IBM_DISCOVERY_URL=your_discovery_instance_url_here
IBM_DISCOVERY_PROJECT_ID=your_discovery_project_id_here
IBM_DISCOVERY_VERSION=2023-03-31

# ════════════════════════════════════════════════════════════════
# DATABASE
# ════════════════════════════════════════════════════════════════

# SQLite (default, no setup required)
DATABASE_URL=sqlite:///finsaakhi.db

# PostgreSQL example (for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/finsaakhi

# ════════════════════════════════════════════════════════════════
# VECTOR DATABASE (ChromaDB)
# ════════════════════════════════════════════════════════════════

CHROMA_PERSIST_DIR=./chroma_db

# ════════════════════════════════════════════════════════════════
# ADMIN DASHBOARD AUTHENTICATION
# ════════════════════════════════════════════════════════════════

# Admin username for monitoring dashboard
ADMIN_USERNAME=admin

# Bcrypt hash of admin password. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'your_password', bcrypt.gensalt(12)).decode())"
# Leave empty to use dev default (admin123) – NOT for production!
ADMIN_PASSWORD_HASH=

# Secret key for session signing (use a long random string in production)
ADMIN_SECRET_KEY=change_me_to_a_random_64_char_string_in_production

# ════════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ════════════════════════════════════════════════════════════════

APP_NAME=FinSakhi
APP_ENV=development
APP_SECRET_KEY=change_me_in_production

# Session timeout in minutes
SESSION_TIMEOUT_MINUTES=30

# ════════════════════════════════════════════════════════════════
# RATE LIMITING
# ════════════════════════════════════════════════════════════════

# Max requests per session per minute window
RATE_LIMIT_MAX_REQUESTS=20
# Window size in seconds
RATE_LIMIT_WINDOW_SECONDS=60
# Max requests per session per hour
RATE_LIMIT_MAX_PER_HOUR=60
# Legacy setting (also used in some places)
MAX_REQUESTS_PER_MINUTE=30

# ════════════════════════════════════════════════════════════════
# LLM / AGENT LIMITS
# ════════════════════════════════════════════════════════════════

MAX_TOKENS_PER_REQUEST=4096
MAX_AGENT_EXECUTION_STEPS=10
AGENT_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=15

# ════════════════════════════════════════════════════════════════
# RAG SETTINGS
# ════════════════════════════════════════════════════════════════

# Maximum number of documents to retrieve per query
RAG_MAX_DOCS=5
# Minimum relevance score to include a document (0.0 – 1.0)
RAG_RELEVANCE_THRESHOLD=0.7
# Maximum chunk size for document splitting
RAG_MAX_CHUNK_SIZE=512

# ════════════════════════════════════════════════════════════════
# MULTILINGUAL SUPPORT
# ════════════════════════════════════════════════════════════════

# Comma-separated language codes
SUPPORTED_LANGUAGES=en,hi,te

# ════════════════════════════════════════════════════════════════
# LOGGING
# ════════════════════════════════════════════════════════════════

LOG_LEVEL=INFO
LOG_FILE=logs/finsaakhi.log
AUDIT_LOG_FILE=logs/audit.log

# ════════════════════════════════════════════════════════════════
# ALERT THRESHOLDS (for monitoring dashboard)
# ════════════════════════════════════════════════════════════════

# Latency above this triggers alert (milliseconds)
ALERT_HIGH_LATENCY_MS=5000
# Success rate below this triggers alert (percentage)
ALERT_LOW_SUCCESS_RATE=80
# Error rate above this triggers alert (percentage)
ALERT_HIGH_ERROR_RATE=20
# Token usage above this triggers alert (tokens per request)
ALERT_EXCESSIVE_TOKENS=10000
# RAG relevance below this triggers alert (0.0 – 1.0)
ALERT_LOW_RAG_RELEVANCE=0.5
